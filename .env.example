# Bot トークン（必須）
DISCORD_TOKEN=

# 許可する Discord ユーザー ID（カンマ区切り、必須）
# 空にすると誰でも操作できてしまうため起動時に拒否する
ALLOWED_USER_IDS=

# 許可するチャンネル ID（カンマ区切り、任意）
# 空の場合は許可ユーザーがいる全チャンネルを許可する
ALLOWED_CHANNEL_IDS=

# cmd が作業してよいルート（カンマ区切り、必須）
# この配下だけ /cwd で移動できる
ALLOWED_ROOTS=/srv/work

# スラッシュコマンドを即時反映するギルド ID（任意）
# 未指定ならグローバル登録（反映に時間がかかる）
DISCORD_GUILD_ID=

# cmd の実行パス
CMD_BIN=cmd

# 同時に走らせる cmd プロセスの上限
MAX_CONCURRENCY=1

# セッション状態の保存先
SESSIONS_FILE=./sessions.json

# 進捗メッセージを編集する間隔（ミリ秒）
PROGRESS_INTERVAL_MS=1750

# 初回メッセージの既定 cwd（ALLOWED_ROOTS 配下、任意）
# 未指定なら ALLOWED_ROOTS の先頭を使う
DEFAULT_CWD=

# cmd の --max-turns（任意、未指定なら cmd の既定値）
CMD_MAX_TURNS=
